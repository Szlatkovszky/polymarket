{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-lab.local/schemas/decision.schema.json",
  "title": "ResearchLabDecisionEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["ABSTAIN", "PROPOSE"]
    },
    "reason": { "type": "string" },
    "model_name": { "type": "string" },
    "model_version": { "type": "string" },
    "prompt_version": { "type": "string" },
    "data_hash": { "type": "string" },
    "calibration_version": { "type": "string" },
    "forecast": {
      "description": "Required when action=PROPOSE. Ignored/forbidden for ABSTAIN (no forecast import).",
      "$ref": "forecast.schema.json"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "PROPOSE" } } },
      "then": { "required": ["forecast"] }
    },
    {
      "if": { "properties": { "action": { "const": "ABSTAIN" } } },
      "then": { "not": { "required": ["forecast"] } }
    }
  ]
}
