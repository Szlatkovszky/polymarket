# Polymarket Research Lab — local PAPER/DEMO only.
# Copy to .env if you want; never commit secrets. This project has no wallet keys.

# PAPER or DEMO. Separate SQLite files; never mixed. No LIVE mode exists.
LAB_MODE=PAPER

# SQLite directory (created on start). PAPER → data/paper.sqlite, DEMO → data/demo.sqlite
LAB_DATA_DIR=data

# Bind local only.
LAB_HOST=127.0.0.1
LAB_PORT=8000

# fixtures (default, CI/offline) or network (GET-only public Gamma/CLOB probe).
POLYMARKET_DATA_SOURCE=fixtures

# Must be 1/true to allow outbound GET to public Polymarket hosts. Default off.
# Kapu B live discovery uses this same flag (still GET-only; never places orders).
POLYMARKET_ALLOW_NETWORK=0

# Public GET bases (override only for documented mirrors). No order/auth URLs.
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com

# Risk config version. New limits require a new version, tests, and human approval.
LAB_RISK_VERSION=risk-v2

# Grok research client is NOT wired. Ceiling is recorded so a future client cannot
# silently overspend. Leave model empty; enabling does not place trades.
GROK_MODEL=
GROK_ENABLED=0
GROK_COST_CEILING_USD=0

# Weather specialist (PAPER). Fixtures are the CI default. Network NWS GET is
# optional, never places orders, and still ABSTAINs if the contract names a
# different resolution provider.
WEATHER_SPECIALIST_ENABLED=1
WEATHER_DATA_SOURCE=fixtures
NWS_ALLOW_NETWORK=0
NWS_API_BASE=https://api.weather.gov

# Shared research spend ceiling (specialist network GETs + future Grok).
# Fixture weather reads cost 0. The research layer cannot size trades.
RESEARCH_COST_CEILING_USD=5
RESEARCH_NETWORK_UNIT_COST_USD=0.001
# Max adapter/specialist calls counted per paper-run cycle (fixtures still count).
RESEARCH_MAX_CALLS_PER_CYCLE=200
# Sleep between network market fetches in paper-run. 0 for fixtures/CI.
RESEARCH_MIN_INTERVAL_SECONDS=0

# Kapu B discovery limit when listing Gamma markets (fixtures or live GET).
POLYMARKET_DISCOVER_LIMIT=50
